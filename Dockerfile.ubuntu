# Build stage
FROM ubuntu:24.04 AS dependencies

# Install dependencies
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils \
        binutils-mingw-w64-i686 \
        ca-certificates \
        clang \
        curl \
        file \
        gcc-mingw-w64-i686 \
        gdb \
        git \
        lib32gcc-13-dev \
        lib32stdc++-13-dev \
        libc6-dev-i386 \
        liburing-dev \
        linux-libc-dev-i386-cross \
        lld \
        llvm \
        make \
    && rm -rf /var/lib/apt/lists/*

FROM dependencies AS build

# Copy source files
WORKDIR /wibo
COPY . /wibo

# Build type (release, debug, release64, debug64)
ARG BUILD_TYPE=release

# Enable link-time optimization (LTO) for release builds (1, 0)
ARG LTO=1

# Version string (if not provided, defaults to "unknown")
ARG WIBO_VERSION

# Build dynamic binary, then run the fixture tests against it
RUN case "$BUILD_TYPE" in \
        debug|release) ARCH=i686; LIBURING=0 ;; \
        debug64|release64) ARCH=x86_64; LIBURING=1 ;; \
        *) echo "Error: Unsupported build type '$BUILD_TYPE'" >&2; exit 1 ;; \
    esac; \
    CONFIG="${BUILD_TYPE%64}"; \
    if [ "$CONFIG" = release ]; then LTO_VALUE=$LTO; else LTO_VALUE=0; fi; \
    if [ "$LTO_VALUE" = 1 ]; then LINK_FLAGS="-fuse-ld=lld"; else LINK_FLAGS=; fi; \
    echo "Building with CONFIG=$CONFIG ARCH=$ARCH" \
    && make CONFIG="$CONFIG" ARCH="$ARCH" CC=clang LTO="$LTO_VALUE" \
        WIBO_ENABLE_LIBURING="$LIBURING" WIBO_LIBURING_STATIC=1 \
        EXTRA_LDFLAGS="$LINK_FLAGS" WIBO_VERSION="$WIBO_VERSION" all test \
    && WIBO_OUT=$(make -s print-wibo CONFIG="$CONFIG" ARCH="$ARCH") \
    && mkdir -p /wibo/out \
    && cp "$WIBO_OUT" /wibo/out/wibo \
    && ( [ "$CONFIG" != release ] || strip -g /wibo/out/wibo )

# Export binary (usage: docker build -f Dockerfile.ubuntu --target export --output dist .)
FROM scratch AS export
COPY --from=build /wibo/out/wibo .

# Runnable container
FROM ubuntu:24.04
COPY --from=build /wibo/out/wibo /usr/local/bin/wibo
CMD ["/usr/local/bin/wibo"]
